# Client-side Configuration (Safe to bundle into Vite frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Enable only after the Mux server variables below are configured on Netlify.
VITE_MUX_ENABLED=false

# Server-side Secrets (Only configure in Netlify Dashboard / Server environment, NEVER commit or prefix with VITE_)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_IDS=your_chat_id_1,your_chat_id_2
# MUX_TOKEN_ID=your_mux_token_id
# MUX_TOKEN_SECRET=your_mux_token_secret
# MUX_ADMIN_USER_IDS=approved_supabase_auth_user_uuid
